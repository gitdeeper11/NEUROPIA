# NEUROPIA Environment Variables Example (E-LAB-10)
# Neural Cognitive Field Unification for Cross-Domain Dissipative Intelligence

# ============= Unified State Parameters =============
NEUROPIA_SPATIAL_DIM=256
NEUROPIA_K_MAX=96
NEUROPIA_O_SFO_LAYERS=12
NEUROPIA_HIDDEN_CHANNELS=512

# ============= Control Parameters =============
NEUROPIA_UFR_HORIZON_US=800
NEUROPIA_UFR_TIMESTEP_US=40
NEUROPIA_LAMBDA_SAFE=0.05
NEUROPIA_F_MAX=1.2

# ============= Domain Activation =============
NEUROPIA_DOMAINS=plasma,quantum,thermal,chemical,bio,gravitational,ai
NEUROPIA_REGIME=full_fusion_plant
NEUROPIA_ENFORCE_ALL_CONSTRAINTS=true

# ============= GCN Loss Weights (9 Domains) =============
NEUROPIA_LAMBDA_1=1.0
NEUROPIA_LAMBDA_2=8.0
NEUROPIA_LAMBDA_3=12.0
NEUROPIA_LAMBDA_4=4.0
NEUROPIA_LAMBDA_5=3.0
NEUROPIA_LAMBDA_6=5.0
NEUROPIA_LAMBDA_7=2.0
NEUROPIA_LAMBDA_8=6.0
NEUROPIA_LAMBDA_9=7.0

# ============= Hardware Deployment =============
NEUROPIA_TENSORRT_ENABLE=false
NEUROPIA_FPGA_TARGET=versal
NEUROPIA_PRECISION=FP32

# ============= Logging =============
NEUROPIA_LOG_LEVEL=INFO
NEUROPIA_SAVE_RESULTS=true
NEUROPIA_RESULTS_DIR=./results

# ============= API Keys (Optional) =============
# GITHUB_TOKEN=your_token_here
# GITLAB_TOKEN=your_token_here

# ============= Deployment =============
# PYPI_TOKEN=your_pypi_token_here
